# Variáveis públicas usadas pelo navegador
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Variável secreta usada SOMENTE pela rota do servidor que cria administradores.
# No Supabase: Settings > API Keys > Secret key.
# Na Vercel: cadastre sem o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_SUA_CHAVE_SECRETA
